# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=logisense
POSTGRES_USER=logisense
POSTGRES_PASSWORD=logisense_secure_2024

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_2024

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=logisense_minio
MINIO_SECRET_KEY=minio_secure_2024

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=7

# AI — provide EITHER an Anthropic OR an OpenAI key to enable the live AI Agent.
# If both are set, Anthropic (Claude) is used. If neither is set, the app runs
# in offline demo mode with realistic pre-written responses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
AGENT_MODEL_ANTHROPIC=claude-3-5-sonnet-20241022
AGENT_MODEL_OPENAI=gpt-4o
DEMO_MODE=true

# Backend
BACKEND_URL=http://backend:8000
